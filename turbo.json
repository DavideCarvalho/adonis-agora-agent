{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@adonis-agora/agent-dashboard#build:spa": {
      "outputs": ["dist/spa/**"]
    },
    "@adonis-agora/agent#build": {
      "dependsOn": ["^build", "@adonis-agora/agent-dashboard#build:spa"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "AGENT_TEST_PG_URL",
        "AGENT_TEST_MYSQL_URL",
        "AGENT_TEST_REAL_DB",
        "AGENT_TEST_REQUIRE_REAL_DB",
        "CI"
      ],
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_*", "TESTCONTAINERS_*"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
