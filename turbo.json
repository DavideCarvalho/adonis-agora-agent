{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@adonis-agora/agent-dashboard#build:spa": {
      "outputs": ["dist/spa/**"]
    },
    "@adonis-agora/agent#build": {
      "dependsOn": ["^build", "@adonis-agora/agent-dashboard#build:spa"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": ["AGENT_TEST_PG_URL"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
