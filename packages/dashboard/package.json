{
  "name": "@adonis-agora/agent-dashboard",
  "version": "0.7.1",
  "description": "Read-only governance console (spend by model/actor, usage trend, recent threads & tool calls, quota) for @adonis-agora/agent — a dependency-light React SPA served by a thin AdonisJS provider. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-agent.git",
    "directory": "packages/dashboard"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/providers/agent_dashboard_provider.js",
  "types": "./dist/providers/agent_dashboard_provider.d.ts",
  "exports": {
    ".": {
      "types": "./dist/providers/agent_dashboard_provider.d.ts",
      "import": "./dist/providers/agent_dashboard_provider.js",
      "default": "./dist/providers/agent_dashboard_provider.js"
    },
    "./agent_dashboard_provider": {
      "types": "./dist/providers/agent_dashboard_provider.d.ts",
      "import": "./dist/providers/agent_dashboard_provider.js",
      "default": "./dist/providers/agent_dashboard_provider.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && pnpm run build:spa && tsc -p tsconfig.build.json && pnpm run check:dist",
    "build:spa": "vite build",
    "check:dist": "node ../../scripts/assert-build-output.mjs dist providers/agent_dashboard_provider.js",
    "clean": "rm -rf dist",
    "prepack": "pnpm run check:dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.3.0",
    "@adonis-agora/agent": ">=0.21.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/core": "7.4.0",
    "@adonis-agora/agent": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "ai",
    "agent",
    "governance",
    "dashboard",
    "spa",
    "react",
    "spend",
    "usage",
    "agora"
  ]
}
