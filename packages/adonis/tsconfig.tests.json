{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "tsBuildInfoFile": null,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "providers/**/*.ts",
    "configure.ts",
    "stubs/main.ts",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["dist/**", "test/fixtures/sandbox-kit/**"]
}
