{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/coverage",
      "!**/*.stub",
      "!**/*-generated.ts",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml",
      "!**/src/doctor/agora_doctor.ts",
      "!**/commands/agora_doctor.ts",
      "!scripts/check-agora-doctor.mjs"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noBannedTypes": "off", "noStaticOnlyClass": "off" },
      "correctness": { "noReactNativeRawText": "off" },
      "style": { "noNonNullAssertion": "off", "useImportType": "off" },
      "suspicious": { "noExplicitAny": "error", "noEmptyInterface": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.spec.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "correctness": { "noComponentHookFactories": "off" }
        }
      }
    },
    {
      "includes": ["**/react-native/**"],
      "linter": { "rules": { "correctness": { "noReactNativeRawText": "error" } } }
    }
  ]
}
